---
/**
 * Layout base: SEO completo (canonical, Open Graph, X, datos estructurados Person + WebSite), verificación de
 * buscadores, fuentes auto-alojadas y medición (GTM con GA4 dentro + Clarity) cargada sin frenar la página.
 */
import { Font } from 'astro:assets';
import Splash from '@/components/organisms/Splash.astro';
import '@/styles/global.css';
import { site } from '@/data/site';
import foto from '@/assets/img/jorge-sanchez.png';
import ogInicio from '@/assets/og-inicio.jpg';
import ogInicioCuadrada from '@/assets/og-inicio-cuadrada.jpg';

/** Imagen para redes: horizontal 1,91:1 (LinkedIn, Facebook, X) + cuadrada (WhatsApp, iMessage). */
type OgImage = { src: ImageMetadata; alt: string };
const ogAlt = 'Jorge Sánchez, ingeniero de sistemas y desarrollador web en Barranquilla.';
const ogDefault: OgImage[] = [
  { src: ogInicio, alt: ogAlt },
  { src: ogInicioCuadrada, alt: ogAlt },
];

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImages?: OgImage[];
  /** Páginas internas (blog, casos): sin la firma de entrada, que es la bienvenida de la portada. */
  sinSplash?: boolean;
  /** «article» en el blog y los casos; «profile» en la portada. */
  ogType?: 'profile' | 'article';
  /** Datos estructurados extra de la página (BlogPosting, CreativeWork, BreadcrumbList…). */
  schema?: object[];
}
const { title = site.title, description = site.description, noindex = false, ogImages = ogDefault, sinSplash = false, ogType = 'profile', schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogs = ogImages.map((o) => ({ ...o, url: new URL(o.src.src, Astro.site).toString() }));
const home = Astro.site!.toString();
const sameAs = Object.values(site.social).filter(Boolean);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${home}#jorge`,
  name: site.name,
  url: home,
  image: new URL(foto.src, Astro.site).toString(),
  alternateName: ['Jorge Sanchez', 'Jorge Luis Sánchez Barreneche', 'Jorge Luis Sanchez Barreneche'],
  jobTitle: 'Ingeniero de Sistemas y desarrollador full stack',
  description: site.description,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.region, addressCountry: site.country },
  givenName: 'Jorge Luis',
  familyName: 'Sánchez Barreneche',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad del Norte', url: 'https://www.uninorte.edu.co' },
  worksFor: { '@type': 'Organization', name: 'Solinces' },
  hasOccupation: { '@type': 'Occupation', name: 'Ingeniero de Sistemas y desarrollador full stack', occupationLocation: { '@type': 'City', name: 'Barranquilla' } },
  award: ['Segundo puesto nacional IEEEXtreme (2024)', 'Primer puesto Feria Gamer Uninorte (2025)'],
  mainEntityOfPage: new URL('/jorge-sanchez', Astro.site).toString(),
  knowsAbout: ['Liderazgo técnico', 'Desarrollo full stack', 'LLM', 'RAG', 'Agentes de IA', 'Java', 'PostgreSQL', 'Ingeniería de sistemas', 'Desarrollo web', 'Tiendas en línea', 'Aplicaciones a la medida', 'Inteligencia artificial', 'SEO', 'Astro', 'React', 'Next.js', 'NestJS', 'Oracle APEX'],
  ...(sameAs.length && { sameAs }),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${home}#sitio`,
  name: site.name,
  url: home,
  inLanguage: 'es-CO',
  publisher: { '@id': `${home}#jorge` },
};
const { gtmId, searchConsole, bing, clarity } = site.analytics;
---
<!doctype html>
<html lang={site.lang} data-no-splash={sinSplash ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#FDFDFD" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    {ogType === 'profile' && <meta property="profile:first_name" content="Jorge" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Sánchez" />}
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogs.map((o) => (
      <>
        <meta property="og:image" content={o.url} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(o.src.width)} />
        <meta property="og:image:height" content={String(o.src.height)} />
        <meta property="og:image:alt" content={o.alt} />
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogs[0].url} />
    <meta name="twitter:image:alt" content={ogs[0].alt} />
    <meta name="geo.region" content="CO-ATL" />
    <meta name="geo.placename" content={site.city} />
    {searchConsole && <meta name="google-site-verification" content={searchConsole} />}
    {bing && <meta name="msvalidate.01" content={bing} />}

    <!--
      Antes de pintar: la firma (splash) una vez por sesión y la entrada del nombre con partículas (solo escritorio
      con mouse). Sin JS o con «reducir movimiento» no aparece ninguna.
    -->
    <script is:inline>
      (function () {
        var r = document.documentElement, calm = matchMedia('(prefers-reduced-motion: reduce)').matches, splash = false;
        if (!calm && !r.hasAttribute('data-no-splash')) {
          try { if (!sessionStorage.getItem('firma-splash')) { splash = true; sessionStorage.setItem('firma-splash', '1'); } } catch (e) {}
        }
        if (splash) r.classList.add('splash');
        if (!calm && matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
          r.classList.add('intro-nombre');
          setTimeout(function () { r.classList.remove('intro-nombre'); }, splash ? 9000 : 4000);
        }
      })();
    </script>
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-grotesk" preload />
    <Font cssVariable="--font-mrs" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />

    <!--
      Medición (igual que Pulxxe): Google Tag Manager (GA4 configurado DENTRO de GTM) y Microsoft Clarity.
      Se inyectan cuando la página ya cargó y el navegador está libre, para no afectar LCP/INP.
      Los eventos que se empujan antes (dataLayer, clarity()) quedan en cola y se envían al cargar.
    -->
    {(gtmId || clarity) && (
      <script is:inline define:vars={{ gtmId, clarity }}>
        window.dataLayer = window.dataLayer || [];
        window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
        // Consentimiento (Google Consent Mode v2 + Clarity Consent API v2): todo empieza DENEGADO hasta que la persona
        // acepte en el aviso de cookies. Va antes de cargar GTM/Clarity para que ninguna etiqueta guarde cookies antes.
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        var previo = null;
        try { var c = document.cookie.match(/(?:^|; )cc_cookie=([^;]*)/); if (c) previo = JSON.parse(decodeURIComponent(c[1])); } catch (e) {}
        var analitica = !!(previo && previo.categories && previo.categories.indexOf('analytics') > -1);
        window.gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: analitica ? 'granted' : 'denied', functionality_storage: 'granted', security_storage: 'granted',
          wait_for_update: 500,
        });
        window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: analitica ? 'granted' : 'denied' });
        var add = function (src) { var t = document.createElement('script'); t.async = true; t.src = src; document.head.appendChild(t); };
        var loadTags = function () {
          if (gtmId) {
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
            add('https://www.googletagmanager.com/gtm.js?id=' + gtmId);
          }
          if (clarity) add('https://www.clarity.ms/tag/' + clarity);
        };
        var whenIdle = function () {
          if ('requestIdleCallback' in window) requestIdleCallback(loadTags, { timeout: 2000 });
          else setTimeout(loadTags, 1);
        };
        if (document.readyState === 'complete') whenIdle(); else window.addEventListener('load', whenIdle, { once: true });
      </script>
    )}
  </head>
  <body>
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    {!sinSplash && <Splash />}
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:p-3">Saltar al contenido</a>
    <slot />
    <script>
      import { initLeadTracking } from '@/scripts/leads';
      import { iniciarConsentimiento } from '@/scripts/consentimiento';
      initLeadTracking();
      iniciarConsentimiento();
    </script>
  </body>
</html>
