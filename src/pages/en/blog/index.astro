---
/** Índice del blog: artículo destacado, filtros por tema y lista con entradas animadas. */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/organisms/Nav.astro';
import Footer from '@/components/organisms/Footer.astro';
import FloatingContact from '@/components/organisms/FloatingContact.astro';
import Icon from '@/components/atoms/Icon.astro';
import '@/styles/lectura.css';

const posts = (await getCollection('blogEn')).sort((a, b) => +b.data.fecha - +a.data.fecha);
const categorias = [...new Set(posts.map((p) => p.data.categoria))];
const [destacado, ...resto] = posts;
const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
const desc =
  "Jorge Sánchez's blog: Oracle APEX, Astro, web performance, architecture and design systems, explained in plain English.";
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: "Jorge Sánchez's Blog",
  url: new URL('/en/blog', Astro.site).toString(),
  inLanguage: 'en',
  author: { '@id': `${Astro.site}#jorge` },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.titulo, url: new URL(`/en/blog/${p.id}`, Astro.site).toString(), datePublished: p.data.fecha.toISOString() })),
}];
---
<BaseLayout title="Blog · Jorge Sánchez · Oracle APEX, Astro and web performance" description={desc} sinSplash schema={schema} lang="en" alternates={{ es: '/blog', en: '/en/blog' }}>
  <Nav lang="en" alternates={{ es: '/blog', en: '/en/blog' }} />
  <main id="contenido" class="mx-auto max-w-[1180px] px-5 pb-24 pt-28 lg:pt-40">
    <header class="grid gap-6 lg:grid-cols-[1.3fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow text-gray" data-revelar>Blog</p>
        <h1 class="mt-3 font-serif text-[48px] leading-[.98] sm:text-[72px] lg:text-[92px]" data-revelar style="--retraso:.06s">What I learn, <em class="accent">explained simply</em></h1>
      </div>
      <p class="body-text max-w-[440px] text-[17px]" data-revelar style="--retraso:.12s">Every article comes with a demo you can play with. Tap ♡ on the paragraph that helped you and comment right where you have a question.</p>
    </header>

    <a href={`/en/blog/${destacado.id}`} class="tarjeta-blog mt-16 !gap-4 !py-10 lg:grid-cols-[1fr_1fr] lg:items-end lg:!gap-12" data-revelar>
      <div>
        <p class="eyebrow text-red">Latest · {destacado.data.categoria}</p>
        <h2 class="mt-3 font-serif text-[36px] leading-[1.02] text-ink sm:text-[52px]">{destacado.data.titulo}</h2>
      </div>
      <div class="flex flex-col gap-4">
        <p class="body-text">{destacado.data.extracto}</p>
        <p class="flex items-center gap-4 text-[13px] text-gray"><time datetime={destacado.data.fecha.toISOString()}>{fmt.format(destacado.data.fecha)}</time><span>{destacado.data.minutos} min</span><span class="flecha ml-auto text-red"><Icon name="arrow-right" /></span></p>
      </div>
    </a>

    <div class="mt-14 flex flex-wrap gap-2" role="group" aria-label="Filter by topic" data-revelar>
      <button type="button" class="chip-filtro" aria-pressed="true" data-filtro="">All</button>
      {categorias.map((c) => <button type="button" class="chip-filtro" aria-pressed="false" data-filtro={c}>{c}</button>)}
    </div>

    <ol class="mt-6 grid gap-x-12 md:grid-cols-2" aria-live="polite">
      {resto.map((p, i) => (
        <li data-categoria={p.data.categoria}>
          <a href={`/en/blog/${p.id}`} class="tarjeta-blog h-full" data-revelar style={`--retraso:${(i % 2) * 0.08}s`}>
            <span class="flex items-center gap-3 text-[13px] text-gray"><span class="font-display text-[22px] leading-none text-ink/25">{String(i + 2).padStart(2, '0')}</span><span class="eyebrow">{p.data.categoria}</span><span class="ml-auto">{p.data.minutos} min</span></span>
            <h2 class="font-serif text-[30px] leading-[1.05] text-ink">{p.data.titulo}</h2>
            <p class="body-text line-clamp-2">{p.data.extracto}</p>
            <span class="flex items-center gap-2 text-[13px] text-ink"><span class="size-1.5 rounded-full bg-red" aria-hidden="true"></span>Interactive demo<span class="flecha ml-auto text-red"><Icon name="arrow-right" /></span></span>
          </a>
        </li>
      ))}
    </ol>
  </main>
  <Footer lang="en" />
  <FloatingContact lang="en" />
</BaseLayout>

<script>
  import { revelar } from '@/scripts/blog/revelar';
  revelar();
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro;
      botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-categoria]').forEach((li) => {
        const ver = !f || li.dataset.categoria === f;
        li.hidden = !ver;
        if (ver) li.querySelector('[data-revelar]')?.classList.add('visible');
      });
    }),
  );
</script>
