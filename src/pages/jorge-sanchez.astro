---
/**
 * «Sobre mí»: la página que identifica a Jorge Sánchez como persona para Google y las IA (ProfilePage + Person).
 * Nombre completo, profesión, ciudad, experiencia, formación, reconocimientos, habilidades y proyectos.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/organisms/Nav.astro';
import Footer from '@/components/organisms/Footer.astro';
import FloatingContact from '@/components/organisms/FloatingContact.astro';
import Button from '@/components/atoms/Button.astro';
import Icon from '@/components/atoms/Icon.astro';
import foto from '@/assets/img/jorge-sanchez.png';
import { perfil, mesAnio } from '@/data/perfil';
import { site, whatsappUrl } from '@/data/site';
import '@/styles/lectura.css';

const casos = (await getCollection('proyectos')).sort((a, b) => b.data.anio - a.data.anio);
const posts = (await getCollection('blog')).sort((a, b) => +b.data.fecha - +a.data.fecha).slice(0, 3);
const home = Astro.site!.toString();
const url = new URL('/jorge-sanchez', Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${url}#pagina`,
    url,
    name: `${perfil.nombre} · Sobre mí`,
    inLanguage: 'es-CO',
    dateModified: new Date().toISOString(),
    mainEntity: { '@id': `${home}#jorge` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: home },
      { '@type': 'ListItem', position: 2, name: perfil.nombre, item: url },
    ],
  },
];
---
<BaseLayout title="Jorge Sánchez · Ingeniero de Sistemas y desarrollador full stack" description="Jorge Sánchez (Jorge Luis Sánchez Barreneche), ingeniero de sistemas de Uninorte y desarrollador full stack en Barranquilla: experiencia, proyectos y contacto." sinSplash schema={schema}>
  <Nav />
  <main id="contenido">
    <section class="mx-auto grid max-w-[1180px] gap-10 px-5 pt-28 lg:grid-cols-[1.2fr_1fr] lg:items-end lg:pt-36">
      <div>
        <p class="eyebrow text-gray" data-revelar>Sobre mí</p>
        <h1 class="mt-3 font-display text-[64px] uppercase leading-[1.05] sm:text-[96px] lg:text-[128px]" data-revelar style="--retraso:.05s">Jorge<br />Sánchez</h1>
        <p class="mt-5 font-serif text-[26px] leading-[1.15] sm:text-[32px]" data-revelar style="--retraso:.1s"><em class="accent">Ingeniero de Sistemas</em> y desarrollador full stack en {site.city}</p>
        <p class="mt-6 max-w-[620px] text-[17px] leading-[1.65] text-body" data-revelar style="--retraso:.15s">{perfil.resumen}</p>
        <p class="mt-3 text-[14px] text-gray" data-revelar style="--retraso:.18s">Nombre completo: {perfil.nombreCompleto}.</p>
        <div class="mt-8 flex flex-wrap gap-3" data-revelar style="--retraso:.22s">
          <Button href={whatsappUrl('Hola Jorge, vi tu perfil y quiero hablar de un proyecto.')} external>Escríbeme por WhatsApp</Button>
          <Button href={site.social.linkedin} variant="secondary" external>LinkedIn</Button>
          <Button href={site.social.github} variant="secondary" external>GitHub</Button>
        </div>
      </div>
      <div class="imagen-revela relative mx-auto w-full max-w-[460px] overflow-hidden bg-[radial-gradient(closest-side,rgb(255_158_107/0.45),rgb(255_191_153/0.15)_55%,transparent)]">
        <Image src={foto} alt="Jorge Sánchez, ingeniero de sistemas y desarrollador full stack en Barranquilla" widths={[360, 540, 720]} sizes="(min-width: 1024px) 460px, 90vw" class="h-auto w-full" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-[1180px] px-5" aria-labelledby="experiencia">
      <h2 id="experiencia" class="h2" data-revelar>Experiencia</h2>
      <ol class="mt-8">
        {perfil.experiencia.map((e, i) => (
          <li class="grid gap-2 border-t border-line py-7 md:grid-cols-[220px_1fr]" data-revelar style={`--retraso:${i * 0.05}s`}>
            <p class="text-[14px] text-gray">{mesAnio(e.desde)} – {e.hasta ? mesAnio(e.hasta) : 'hoy'}<br />{e.modalidad}</p>
            <div>
              <h3 class="font-serif text-[28px] leading-[1.1]">{e.cargo} <span class="text-gray">· {e.empresa}</span></h3>
              {e.proyecto && <p class="eyebrow mt-2 text-red">Proyecto: {e.proyecto}</p>}
              <p class="mt-2 max-w-[680px] text-[16px] leading-[1.6] text-body">{e.texto}</p>
              {e.logros && (
                <ul class="mt-5 grid max-w-[880px] gap-3 sm:grid-cols-2">
                  {e.logros.map((l) => (
                    <li class="border border-line bg-paper-2 p-4">
                      <p class="text-[15px] font-medium text-ink">{l.t}</p>
                      <p class="mt-1 text-[14px] leading-[1.5] text-body">{l.d}</p>
                    </li>
                  ))}
                </ul>
              )}
              {e.tecnologias && <p class="mt-4 flex flex-wrap gap-1.5">{e.tecnologias.map((t) => <span class="border border-line px-2 py-0.5 text-[12px]">{t}</span>)}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mx-auto mt-16 grid max-w-[1180px] gap-12 px-5 md:grid-cols-3" aria-label="Formación y reconocimientos">
      <div data-revelar>
        <h2 class="eyebrow text-gray">Formación</h2>
        {perfil.formacion.map((f) => <p class="mt-4 font-serif text-[24px] leading-[1.15]">{f.titulo}<span class="mt-1 block font-sans text-[14px] text-gray">{f.institucion} · {f.anio}</span></p>)}
      </div>
      <div data-revelar style="--retraso:.06s">
        <h2 class="eyebrow text-gray">Reconocimientos</h2>
        <ul class="mt-4 grid gap-3">{perfil.reconocimientos.map((r) => <li class="text-[15px] leading-[1.45]">{r.titulo}<span class="block text-[13px] text-gray">{r.por} · {r.anio}</span></li>)}</ul>
      </div>
      <div data-revelar style="--retraso:.12s">
        <h2 class="eyebrow text-gray">Certificaciones</h2>
        <ul class="mt-4 grid gap-3">{perfil.certificaciones.map((c) => <li class="text-[15px] leading-[1.45]">{c.nombre}<span class="block text-[13px] text-gray">{c.emisor} · {c.anio}</span></li>)}</ul>
      </div>
    </section>

    <section class="mx-auto mt-20 max-w-[1180px] px-5" aria-labelledby="stack">
      <h2 id="stack" class="h2" data-revelar>Con qué <em class="accent">trabajo</em></h2>
      <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {Object.entries(perfil.habilidades).map(([grupo, items], i) => (
          <div data-revelar style={`--retraso:${i * 0.05}s`}>
            <dt class="eyebrow text-gray">{grupo}</dt>
            <dd class="mt-3 flex flex-wrap gap-1.5">{items.map((h) => <span class="border border-line px-2.5 py-1 text-[13px]">{h}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mx-auto mt-20 max-w-[1180px] px-5" aria-labelledby="proyectos">
      <h2 id="proyectos" class="h2" data-revelar>Proyectos de <em class="accent">Jorge Sánchez</em></h2>
      <ul class="mt-8 grid gap-x-10 md:grid-cols-2">
        {casos.map((c, i) => (
          <li><a href={`/proyectos/${c.id}`} class="tarjeta-blog" data-revelar style={`--retraso:${(i % 2) * 0.06}s`}>
            <span class="eyebrow text-gray">{c.data.cliente ?? 'Proyecto propio'} · {c.data.anio}</span>
            <h3 class="font-serif text-[28px] leading-[1.05]">{c.data.titulo}</h3>
            <p class="body-text line-clamp-2">{c.data.resumen}</p>
            <span class="flecha text-red"><Icon name="arrow-right" /></span>
          </a></li>
        ))}
      </ul>
      <p class="mt-10 text-[15px] text-body" data-revelar>Servicios: <a class="text-red underline underline-offset-4" href="/desarrollador-full-stack-barranquilla">desarrollador full stack en Barranquilla</a> · <a class="text-red underline underline-offset-4" href="/ingeniero-de-sistemas-barranquilla">ingeniero de sistemas en Barranquilla</a> · <a class="text-red underline underline-offset-4" href="/blog">artículos del blog</a> ({posts.map((p) => p.data.titulo).slice(0, 1)} y más).</p>
    </section>
  </main>
  <Footer />
  <FloatingContact />
</BaseLayout>

<script>
  import { revelar } from '@/scripts/blog/revelar';
  revelar();
</script>
