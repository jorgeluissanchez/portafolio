---
/** Átomo · Botón (Figma: componente «Botón», tipos Primario y Secundario). Siempre es un enlace. */
import Icon from './Icon.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'class'> { href: string; variant?: 'primary' | 'secondary'; external?: boolean; class?: string }
const { href, variant = 'primary', external = false, class: cls, ...rest } = Astro.props;
---
<a href={href} class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', cls]} {...(external && { target: '_blank', rel: 'noopener' })} {...rest}>
  <slot />
  <Icon name="arrow-right" />
</a>
