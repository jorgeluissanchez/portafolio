---
/** Átomo · Íconos de línea fina (trazo 1,25) del Figma. Decorativos: el texto accesible va en el botón. */
type Name = 'arrow-right' | 'arrow-left' | 'arrow-up' | 'menu' | 'close' | 'instagram' | 'github' | 'linkedin' | 'whatsapp';
interface Props { name: Name; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.25, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'whatsapp' ? (
  <svg width={size} height={Math.round(size * 32 / 28)} viewBox="0 0 28 32" aria-hidden="true" class={cls}><path fill="currentColor" d="M23.8 6.07A13.8 13.8 0 0 0 14 2C6.34 2 .12 8.23.12 15.88c0 2.44.64 4.83 1.85 6.93L0 30l7.36-1.93a13.8 13.8 0 0 0 6.63 1.69h.01C21.64 29.76 28 23.53 28 15.88c0-3.7-1.57-7.19-4.2-9.81ZM13.99 27.42c-2.07 0-4.1-.56-5.87-1.61l-.42-.25-4.36 1.14 1.16-4.25-.27-.44a11.5 11.5 0 0 1-1.77-6.14C2.46 9.52 7.64 4.34 14 4.34c3.08 0 5.98 1.2 8.15 3.38 2.17 2.18 3.51 5.08 3.5 8.16 0 6.36-5.3 11.54-11.66 11.54Zm6.33-8.64c-.35-.17-2.05-1.01-2.37-1.13-.32-.12-.55-.17-.78.17-.23.35-.9 1.13-1.1 1.36-.2.23-.4.26-.75.09-2.04-1.02-3.38-1.82-4.72-4.13-.36-.61.36-.57 1.02-1.9.11-.23.06-.43-.03-.6-.09-.18-.78-1.88-1.07-2.58-.28-.68-.57-.58-.78-.6h-.66c-.23 0-.61.09-.93.43-.32.35-1.21 1.19-1.21 2.9 0 1.7 1.24 3.35 1.41 3.58.18.23 2.45 3.73 5.93 5.24 2.2.95 3.06 1.03 4.16.87.67-.1 2.05-.84 2.34-1.65.29-.81.29-1.5.2-1.65-.08-.16-.31-.24-.66-.41Z"/></svg>
) : (
  <svg width={size} height={size} viewBox={name.startsWith('arrow') ? '0 0 16 16' : '0 0 24 24'} aria-hidden="true" class={cls} {...stroke}>
    {name === 'arrow-right' && <><path d="M3 8h10" /><path d="m9 4 4 4-4 4" /></>}
    {name === 'arrow-left' && <><path d="M13 8H3" /><path d="m7 4-4 4 4 4" /></>}
    {name === 'arrow-up' && <><path d="M8 14V2" /><path d="m3 7 5-5 5 5" /></>}
    {name === 'menu' && <><path d="M3 8h18" /><path d="M3 16h18" /></>}
    {name === 'close' && <><path d="m5 5 14 14" /><path d="M19 5 5 19" /></>}
    {name === 'instagram' && <><rect x="2.5" y="2.5" width="19" height="19" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.6" cy="6.4" r=".6" fill="currentColor" /></>}
    {name === 'github' && <><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></>}
    {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></>}
  </svg>
)}
