---
/** Organismo · Menú. Escritorio: enlaces + botón. Móvil: firma + ícono de menú que abre el panel. */
import Button from '@/components/atoms/Button.astro';
import Icon from '@/components/atoms/Icon.astro';
import * as es from '@/data/content';
import * as en from '@/data/content.en';
import { site, whatsappUrl } from '@/data/site';
import { ui, inicioDe, type Lang, type Alternates } from '@/i18n';
interface Props { lang?: Lang; alternates?: Alternates }
const { lang = 'es', alternates = {} } = Astro.props;
const { nav } = lang === 'en' ? en : es;
const t = ui[lang];
const otro: Lang = lang === 'en' ? 'es' : 'en';
// Si la página no tiene versión en el otro idioma, el selector lleva al inicio de ese idioma (nunca a un 404)
const hrefOtro = alternates[otro] ?? inicioDe[otro];
const wa = whatsappUrl(t.waDefecto);
---
<header class="fixed inset-x-0 top-0 z-30 transition-[background-color,box-shadow,backdrop-filter] duration-300 data-[scrolled]:bg-paper/85 data-[scrolled]:shadow-[0_1px_0_rgb(17_17_17/0.08)] data-[scrolled]:backdrop-blur-md" data-header>
  <nav class="mx-auto flex max-w-[1366px] items-center justify-between px-5 py-4 lg:max-w-[calc(1366*var(--u))] lg:px-[calc(64*var(--u))] lg:py-[calc(18*var(--u))]" aria-label={t.principal}>
    <a href={inicioDe[lang]} class="firma text-[28px] text-ink lg:text-[calc(32*var(--u))]" aria-label={`${site.name}, ${t.inicio}`}>{site.name}</a>
    <div class="hidden items-center gap-[calc(32*var(--u))] lg:flex">
      <ul class="flex gap-[calc(32*var(--u))] text-[length:max(13px,calc(15*var(--u)))]">
        {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-red">{n.label}</a></li>)}
      </ul>
      <a href={hrefOtro} hreflang={otro} lang={otro} class="eyebrow transition-colors hover:text-red" aria-label={t.otroIdioma}>{t.otroIdiomaCorto}</a>
      <Button href={wa} external>{t.cotiza}</Button>
    </div>
    <button type="button" class="p-2 lg:hidden" aria-label={t.abrirMenu} aria-expanded="false" aria-controls="menu-movil" data-menu-open>
      <Icon name="menu" size={24} />
    </button>
  </nav>
</header>
<!-- Fuera del <header>: el desenfoque del menú fijo (backdrop-filter) atraparía este panel «fixed» dentro de la barra y se vería transparente encima del contenido -->
<div id="menu-movil" class="fixed inset-0 z-40 hidden flex-col bg-paper px-5 py-4 lg:hidden" data-menu>
  <div class="flex items-center justify-between">
    <span class="firma text-[28px]">{site.name}</span>
    <button type="button" class="p-2" aria-label={t.cerrarMenu} data-menu-close><Icon name="close" size={24} /></button>
  </div>
  <ul class="mt-12 flex flex-col gap-6">
    {nav.map((n) => <li><a href={n.href} class="h2" data-menu-link>{n.label}</a></li>)}
    <li><a href={hrefOtro} hreflang={otro} lang={otro} class="eyebrow text-gray" data-menu-link>{t.otroIdioma}</a></li>
  </ul>
  <Button href={wa} external class="mt-auto">{t.cotiza}</Button>
</div>


<script>
  // Menú fijo: al bajar toma fondo para que se lea sobre cualquier sección
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const toggle = (show: boolean) => {
    if (!menu || !open) return;
    menu.classList.toggle('hidden', !show);
    menu.classList.toggle('flex', show);
    open.setAttribute('aria-expanded', String(show));
    document.body.style.overflow = show ? 'hidden' : '';
  };
  open?.addEventListener('click', () => toggle(true));
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => toggle(false));
  document.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => toggle(false)));
</script>
