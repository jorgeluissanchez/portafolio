---
/**
 * Organismo · Pantalla de entrada: la firma «Jorge Sánchez» (Mrs Saint Delafield, la del Figma) se escribe a mano.
 *
 * Cómo funciona:
 *  - La tinta es el texto real convertido a trazado SVG (src/data/firma.json → glyphs), pintado en un canvas.
 *  - src/assets/firma-tiempos.png es un «mapa de tiempos»: cada píxel de tinta guarda el instante en que la pluma
 *    pasa por él (gris 0 = al empezar, 254 = al terminar). Se calculó del trazo central de la letra, en el orden
 *    en que se escribe: el palo de la J, el bucle, «orge», la S desde el rabo de abajo, «ánchez» y la tilde al final.
 *    En los cruces, la tinta compartida es de la línea que pasa primero, así nada aparece antes de que la pluma llegue.
 *  - Un shader WebGL muestra en cada cuadro solo la tinta cuyo tiempo ya pasó.
 *
 * Una vez por sesión (como Pulxxe); se salta con clic o tecla; sin JS o con «reducir movimiento» no aparece.
 */
import firma from '@/data/firma.json';
import tiempos from '@/assets/firma-tiempos.png';
const [, , vw, vh] = firma.viewBox.split(' ').map(Number);
---
<div class="splash" aria-hidden="true" data-splash data-tiempos={tiempos.src} data-glyphs={firma.glyphs} data-viewbox={firma.viewBox} data-end={firma.end}>
  <canvas class="firma-canvas" style={`aspect-ratio:${vw}/${vh}`}></canvas>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-splash]');
  const root = document.documentElement;

  const VS = 'attribute vec2 p;varying vec2 uv;void main(){uv=vec2(p.x*.5+.5,.5-p.y*.5);gl_Position=vec4(p,0.,1.);}';
  const FS = `precision mediump float;varying vec2 uv;uniform sampler2D tinta;uniform sampler2D tiempo;uniform float t;
    void main(){float a=texture2D(tinta,uv).a;float k=texture2D(tiempo,uv).r*255./254.;
    float v=clamp((t-k)*500.,0.,1.);gl_FragColor=vec4(vec3(.067)*a*v,a*v);}`;

  function iniciar(el: HTMLElement, onEnd: () => void) {
    const canvas = el.querySelector('canvas')!;
    const end = parseFloat(el.dataset.end || '3.6');
    const [vx, vy, vw, vh] = (el.dataset.viewbox || '').split(' ').map(Number);
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = Math.round(canvas.clientWidth * dpr), H = Math.round(canvas.clientHeight * dpr);
    canvas.width = W; canvas.height = H;
    // Tinta: el trazado de la firma a la resolución de la pantalla
    const off = document.createElement('canvas'); off.width = W; off.height = H;
    const c2 = off.getContext('2d')!;
    c2.setTransform(W / vw, 0, 0, H / vh, (-vx * W) / vw, (-vy * H) / vh);
    c2.fill(new Path2D(el.dataset.glyphs || ''));
    const gl = canvas.getContext('webgl', { premultipliedAlpha: true, alpha: true });
    const img = new Image();
    img.onload = () => {
      if (!gl) { canvas.getContext('2d')?.drawImage(off, 0, 0); setTimeout(onEnd, 1200); return; }
      const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
      const pr = gl.createProgram()!;
      gl.attachShader(pr, sh(gl.VERTEX_SHADER, VS)); gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, FS)); gl.linkProgram(pr); gl.useProgram(pr);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const tex = (unit: number, src: TexImageSource, name: string) => {
        gl.activeTexture(gl.TEXTURE0 + unit); gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, src);
        for (const p of [gl.TEXTURE_WRAP_S, gl.TEXTURE_WRAP_T]) gl.texParameteri(gl.TEXTURE_2D, p, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.uniform1i(gl.getUniformLocation(pr, name), unit);
      };
      tex(0, off, 'tinta'); tex(1, img, 'tiempo');
      const ut = gl.getUniformLocation(pr, 't');
      gl.viewport(0, 0, W, H);
      const t0 = performance.now();
      const frame = (now: number) => {
        const s = (now - t0) / 1000;
        gl.uniform1f(ut, s / end); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        if (s < end + 0.05) requestAnimationFrame(frame); else setTimeout(onEnd, 850);
      };
      requestAnimationFrame(frame);
    };
    img.onerror = onEnd;
    img.src = el.dataset.tiempos || '';
  }

  if (el && root.classList.contains('splash')) {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      el.classList.add('is-out');
      root.classList.remove('splash');
      window.dispatchEvent(new Event('splash:done'));
      setTimeout(() => el.remove(), 700);
    };
    const skip = () => finish();
    el.addEventListener('click', skip, { once: true });
    addEventListener('keydown', skip, { once: true });
    setTimeout(finish, 8000); // por si algo falla, nunca se queda tapando la página
    iniciar(el, finish);
  } else el?.remove();
</script>

<style>
  .splash { display: none; }
  :global(html.splash) .splash,
  .splash.is-out {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    background: var(--color-paper);
    cursor: pointer;
  }
  :global(html.splash) { overflow: hidden; }
  .firma-canvas { width: min(78vw, 760px); height: auto; display: block; }
  /* Salida: la pantalla se desvanece y la firma sube un poco (ease-out, 600 ms) */
  .splash.is-out { opacity: 0; pointer-events: none; transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .splash.is-out .firma-canvas { transform: translateY(-12px) scale(0.98); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  @media (prefers-reduced-motion: reduce) {
    .splash { display: none !important; }
  }
</style>
